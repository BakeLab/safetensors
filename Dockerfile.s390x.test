FROM ubuntu:26.04

# Ubuntu supplies native s390x PyTorch for the system Python 3.14.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates cargo gcc libc6-dev python3-dev python3-pytest python3-torch python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv --system-site-packages /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /safetensors
COPY . .
WORKDIR /safetensors/bindings/python
RUN python -m pip install .
RUN python -m pytest -sv tests/test_pt_* tests/test_simple.py
